rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Slide validation
    function isValidSlide(data) {
      return data.keys().hasAll(['id', 'titleHighlight', 'titleSuffix']) &&
        data.id is string && data.id.size() <= 100 &&
        data.titleHighlight is string && data.titleHighlight.size() <= 120 &&
        data.titleSuffix is string && data.titleSuffix.size() <= 120 &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 500)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 50)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 800000));
    }

    // Category validation
    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'summary', 'fullDescription']) &&
        data.id is string && data.id.size() <= 100 &&
        data.name is string && data.name.size() <= 150 &&
        data.summary is string && data.summary.size() <= 500 &&
        data.fullDescription is string && data.fullDescription.size() <= 5000 &&
        (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 50)) &&
        (!('bannerImageUrl' in data) || (data.bannerImageUrl is string && data.bannerImageUrl.size() <= 800000)) &&
        (!('referenceLinks' in data) || (data.referenceLinks is list && data.referenceLinks.size() <= 50));
    }

    // Artifact validation
    function isValidArtifact(data) {
      return data.keys().hasAll(['id', 'categoryId', 'title', 'description', 'notes']) &&
        data.id is string && data.id.size() <= 100 &&
        data.categoryId is string && data.categoryId.size() <= 100 &&
        data.title is string && data.title.size() <= 200 &&
        data.description is string && data.description.size() <= 5000 &&
        data.notes is string && data.notes.size() <= 5000 &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 800000)) &&
        (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 1000)) &&
        (!('videoTitle' in data) || (data.videoTitle is string && data.videoTitle.size() <= 200)) &&
        (!('videos' in data) || (data.videos is list && data.videos.size() <= 30)) &&
        (!('noVideoEmbed' in data) || (data.noVideoEmbed is bool));
    }

    // Question validation
    function isValidQuestion(data) {
      return data.keys().hasAll(['id', 'categoryId', 'questionText', 'correctChoiceId']) &&
        data.id is string && data.id.size() <= 100 &&
        data.categoryId is string && data.categoryId.size() <= 100 &&
        data.questionText is string && data.questionText.size() <= 2000 &&
        data.correctChoiceId is string && data.correctChoiceId.size() <= 100 &&
        (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 3000)) &&
        (!('artifactId' in data) || (data.artifactId is string && data.artifactId.size() <= 100)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 800000)) &&
        (!('choices' in data) || (data.choices is list && data.choices.size() <= 10));
    }

    // Public test doc for connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Slides
    match /slides/{slideId} {
      allow get, list: if true;
      allow create: if isValidId(slideId) && isValidSlide(incoming());
      allow update: if isValidId(slideId) && isValidSlide(incoming());
      allow delete: if isValidId(slideId);
    }

    // Categories (Retro, Present, Future)
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    match /present_categories/{categoryId} {
      allow get, list: if true;
      allow create: if isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    match /future_categories/{categoryId} {
      allow get, list: if true;
      allow create: if isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    // Artifacts (Retro, Present, Future)
    match /artifacts/{artifactId} {
      allow get, list: if true;
      allow create: if isValidId(artifactId) && isValidArtifact(incoming());
      allow update: if isValidId(artifactId) && isValidArtifact(incoming());
      allow delete: if isValidId(artifactId);
    }

    match /present_artifacts/{artifactId} {
      allow get, list: if true;
      allow create: if isValidId(artifactId) && isValidArtifact(incoming());
      allow update: if isValidId(artifactId) && isValidArtifact(incoming());
      allow delete: if isValidId(artifactId);
    }

    match /future_artifacts/{artifactId} {
      allow get, list: if true;
      allow create: if isValidId(artifactId) && isValidArtifact(incoming());
      allow update: if isValidId(artifactId) && isValidArtifact(incoming());
      allow delete: if isValidId(artifactId);
    }

    // Questions (Retro, Present, Future)
    match /questions/{questionId} {
      allow get, list: if true;
      allow create: if isValidId(questionId) && isValidQuestion(incoming());
      allow update: if isValidId(questionId) && isValidQuestion(incoming());
      allow delete: if isValidId(questionId);
    }

    match /present_questions/{questionId} {
      allow get, list: if true;
      allow create: if isValidId(questionId) && isValidQuestion(incoming());
      allow update: if isValidId(questionId) && isValidQuestion(incoming());
      allow delete: if isValidId(questionId);
    }

    match /future_questions/{questionId} {
      allow get, list: if true;
      allow create: if isValidId(questionId) && isValidQuestion(incoming());
      allow update: if isValidId(questionId) && isValidQuestion(incoming());
      allow delete: if isValidId(questionId);
    }

    // About & metadata
    match /config/{configId} {
      allow get, list: if true;
      allow create, update: if isValidId(configId);
      allow delete: if isValidId(configId);
    }
  }
}
